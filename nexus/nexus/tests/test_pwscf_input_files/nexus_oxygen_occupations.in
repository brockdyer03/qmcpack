&CONTROL
    calculation  = "scf",
    prefix       = "Oxygen",
    outdir       = "pwscf_output",
    pseudo_dir   = "./pseudo_dir",
    verbosity    = "high",
/

&SYSTEM
    ibrav                     = 1,
    celldm(1)                 = 14,
    nat                       = 1,
    ntyp                      = 1,
    ecutwfc                   = 50,
    nosym                     = .true.,
    occupations               = "from_input",
    nbnd                      = 6,
    nspin                     = 2,
    starting_magnetization(1) = 0.5,
/

&ELECTRONS
    conv_thr    = 1e-07,
/

ATOMIC_SPECIES
    O  15.999 O.BFD.upf

ATOMIC_POSITIONS (bohr)
    O     0.0000000000     0.0000000000     0.0000000000

K_POINTS (gamma)

OCCUPATIONS
    1.00000000 1.00000000 1.00000000 1.00000000 0.00000000 0.00000000
    1.00000000 0.33333333 0.33333333 0.33333333 0.00000000 0.00000000
