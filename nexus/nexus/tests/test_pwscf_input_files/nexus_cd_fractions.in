&CONTROL
    calculation   = "scf",
    nstep         = 100,
    tprnfor       = .true.,
    outdir        = "scf_output",
    prefix        = "scf",
    max_seconds   = 1200,
    etot_conv_thr = 1e-06,
    forc_conv_thr = 0.0001,
    pseudo_dir    = "./",
/

&SYSTEM
    ibrav      = 4,
    a          = 2.97887,
    c          = 5.61765,
    nat        = 2,
    ntyp       = 1,
    tot_charge = 0,
    ecutwfc    = 80,
    ecutrho    = 320,
    input_dft  = "pbe",
/

&ELECTRONS
    conv_thr = 1e-07,
/

ATOMIC_SPECIES
    Cd  112.414 cd_pbesol_v1.uspp.F.UPF

ATOMIC_POSITIONS (crystal)
    Cd    1/3    2/3    1/4
    Cd    2/3    1/3    3/4

K_POINTS (gamma)
