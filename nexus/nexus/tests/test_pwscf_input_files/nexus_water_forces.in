&CONTROL
    calculation   = "relax",
    nstep         = 100,
    tprnfor       = .true.,
    outdir        = "relax_output",
    prefix        = "relax",
    max_seconds   = 1200,
    etot_conv_thr = 1e-06,
    forc_conv_thr = 0.0001,
    pseudo_dir    = "./",
/

&SYSTEM
    ibrav           = 0,
    nat             = 3,
    ntyp            = 2,
    tot_charge      = 0,
    ecutwfc         = 80,
    ecutrho         = 320,
    input_dft       = "pbe",
    assume_isolated = "mp",
/

&ELECTRONS
    conv_thr = 1e-07,
/

&IONS
    ion_dynamics = "bfgs",
/

